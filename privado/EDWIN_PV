    <script>
        // Animaciones "Reveal" al hacer scroll
        function reveal() {
            var reveals = document.querySelectorAll(".reveal");
            for (var i = 0; i < reveals.length; i++) {
                var windowHeight = window.innerHeight;
                var elementTop = reveals[i].getBoundingClientRect().top;
                var elementVisible = 100;
                if (elementTop < windowHeight - elementVisible) {
                    reveals[i].classList.add("active");
                }
            }
        }
        window.addEventListener("scroll", reveal);
        // Trigger inicial
        reveal();

        // Cambio de pestañas en Gastos Médicos
        function switchGMM(plan) {
            const btnPleno = document.getElementById('btn-pleno');
            const btnIntegro = document.getElementById('btn-integro');
            const contentPleno = document.getElementById('content-pleno');
            const contentIntegro = document.getElementById('content-integro');

            if (plan === 'pleno') {
                btnPleno.classList.add('active', 'text-white', 'bg-smnyl-light');
                btnPleno.classList.remove('text-gray-600');
                
                btnIntegro.classList.remove('active', 'text-white', 'bg-smnyl-light');
                btnIntegro.classList.add('text-gray-600');

                contentPleno.classList.remove('hidden');
                contentIntegro.classList.add('hidden');
            } else {
                btnIntegro.classList.add('active', 'text-white', 'bg-smnyl-light');
                btnIntegro.classList.remove('text-gray-600');
                
                btnPleno.classList.remove('active', 'text-white', 'bg-smnyl-light');
                btnPleno.classList.add('text-gray-600');

                contentIntegro.classList.remove('hidden');
                contentPleno.classList.add('hidden');
            }
        }

        // Navbar scroll effect
        window.addEventListener('scroll', function() {
            const nav = document.getElementById('navbar');
            if (window.scrollY > 50) {
                nav.classList.add('shadow-md');
                nav.classList.replace('bg-white/90', 'bg-white');
            } else {
                nav.classList.remove('shadow-md');
                nav.classList.replace('bg-white', 'bg-white/90');
            }
        });
    </script>
